# Configuración local de referencia; no contiene credenciales.
# Web pública (Next.js, puerto 3002). Variables sólo del servidor.
PUBLIC_API_URL=http://127.0.0.1:3000/api/v1
SITE_URL=http://localhost:3002
SITE_INDEXABLE=false
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Configurar antes de habilitar reportes: un correo atendido por el proyecto.
# REPORT_EMAIL=

API_ORIGIN=http://127.0.0.1:3000
API_TIMEOUT_MS=10000

# Auditoría pública acotada: muestra y zona configurables.
API_CHECK_BBOX=-59,-35.2,-57.5,-34
API_CHECK_MAX_PAGES=3
API_CHECK_PAGE_SIZE=20
API_CHECK_MAX_DETAILS=3
API_CHECK_TIMEOUT_MS=5000
API_CHECK_TOTAL_TIMEOUT_MS=30000
